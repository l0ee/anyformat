{
  "name": "anyformat",
  "private": true,
  "version": "2.2.1",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10 <11"
  },
  "description": "Convert images and PDF pages, create SVG graphics, and export files directly in your browser. Your files stay on your device.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l0ee/anyformat.git"
  },
  "bugs": {
    "url": "https://github.com/l0ee/anyformat/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node start-server.js",
    "build": "tsc && vite build && node scripts/generate-site-discovery.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:stress": "cross-env RUN_STRESS_TESTS=1 vitest run tests/stress/tracing.stress.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^1.55.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
