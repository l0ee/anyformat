{
  "name": "svg-converter",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-based raster image tracer and format converter for SVG workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l0ee/svg-converter-and-universal-converter.git"
  },
  "bugs": {
    "url": "https://github.com/l0ee/svg-converter-and-universal-converter/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node start-server.js",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  }
